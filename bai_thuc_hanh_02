#include<stdio.h>
#include<stdlib.h>
int main(){
	int n ;
	float*ma;
	printf("nhap so luong mang");
	scanf("%d",&n);
	if(n < 0){
		printf("so luong khong hop le");
		return 1;
	}
	ma = (float*)malloc(n*sizeof(float));
	if(ma==NULL){
		printf("khong du bo nho");
		return 1;
		
	}
	printf("Mang cac so thuc vua nhap la");
	for(int i = 0 ; i < n ; i++){
		printf("%2f\t",*(ma + i));
		
	}
	printf("\n");
	free(ma);
	return 0;
}
