#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    char ma[20];
    char hoTen[50];
    float diem1;
    float diem2;
    float diem3;
} SinhVien;
void nhapDanhSach(SinhVien *ds, int n) {
    for (int i = 0; i < n; i++) {
        printf("Nhap thong tin sv", i + 1);
        
        printf(", Ma sv ");
        scanf("%s", (ds + i)->ma);
        getchar(); 
        printf("Ho va ten ");
        fgets((ds + i)->hoTen, sizeof((ds + i)->hoTen), stdin);
        size_t len = strlen((ds + i)->hoTen);
        if (len > 0 && (ds + i)->hoTen[len - 1] == '\n') {
            (ds + i)->hoTen[len - 1] = '\0';
        }
        
        printf("Nhap 3 diem  ");
        scanf("%f %f %f", &(ds + i)->diem1, &(ds + i)->diem2, &(ds + i)->diem3);
    }
}
void inDanhSach(SinhVien *ds, int n) {
    printf("Danh sach sv");
    printf("%-12s %-25s %-8  %-8s %-8s\n", "Masv", "Ho va ten", "Diem 1", "Diem 2", "Diem 3");
    printf("\n");
    for (int i = 0; i < n; i++) {
        printf("%-12s %-25s %-8.2f %-8.2f %-8.2f\n", 
               (ds + i)->ma, 
               (ds + i)->hoTen, 
               (ds + i)->diem1, 
               (ds + i)->diem2, 
               (ds + i)->diem3);
    }
    
}
int main() {
    int n;
    printf("Nhap so luong sv ");
    scanf("%d", &n);
    
    if (n <= 0) {
        printf("So luong sv khong hop le");
        return 0;
    }
    SinhVien *ds = (SinhVien *)malloc(n * sizeof(SinhVien));
    if (ds == NULL) {
        printf("Ko du bo nho");
        return 1;
    }
    nhapDanhSach(ds, n);
    inDanhSach(ds, n);
    free(ds);    
    return 0;
}
